<?xml version="1.0" encoding="utf-8" ?>
<!--
    One card, on the results and the favourites page (.my/design/results-list-changes.md). It takes its
    BindingContext from the list item. Every card repeats the same ids; item scoping keeps them apart.

    A click or tap on the card is the list's: it selects the card, and the page opens it in the Open with
    service (.my/rca/card-click.md). A TouchBehavior's tap never ran on Windows, and a list item's own click
    works on every platform.

    Two layers in one cell. Below, Suggestion_Card: the surface for the long press (a right-click on Windows,
    TouchBehavior on a phone, added in code), which shows the other two services. Above, the content: the
    text lets clicks fall through, and the star, More and the Open in links are buttons on top, which take
    their own clicks.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kofflard.Core.ViewModels;assembly=Kofflard.Core"
             x:Class="Kofflard.App.Views.SuggestionCardView"
             x:DataType="vm:SuggestionViewModel">

    <!-- Tinted by its lane: amber Safe, teal Curious, violet Wild (.my/design/aurora.md). -->
    <Border Padding="0"
            Margin="0,6"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="1"
            Background="{AppThemeBinding Light={StaticResource SafeCardLightBrush}, Dark={StaticResource SafeCardDarkBrush}}"
            Stroke="{AppThemeBinding Light={StaticResource SafeEdgeLight}, Dark={StaticResource SafeEdgeDark}}"
            Opacity="{Binding Opacity}">
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding LaneName}" Value="Curious">
                <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource CuriousCardLightBrush}, Dark={StaticResource CuriousCardDarkBrush}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource CuriousEdgeLight}, Dark={StaticResource CuriousEdgeDark}}" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding LaneName}" Value="Wild">
                <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource WildCardLightBrush}, Dark={StaticResource WildCardDarkBrush}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource WildEdgeLight}, Dark={StaticResource WildEdgeDark}}" />
            </DataTrigger>
        </Border.Triggers>
        <Grid>
            <ContentView x:Name="TapSurface"
                         AutomationId="Suggestion_Card"
                         BackgroundColor="Transparent"
                         SemanticProperties.Description="{Binding OpenDescription}"
                         SemanticProperties.Hint="Long press for other services">
                <FlyoutBase.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Open in…" Command="{Binding ShowOtherServicesCommand}" />
                    </MenuFlyout>
                </FlyoutBase.ContextFlyout>
            </ContentView>

            <VerticalStackLayout Padding="8,4,8,14" Spacing="4" InputTransparent="True" CascadeInputTransparent="False">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="2" InputTransparent="True" CascadeInputTransparent="False">
                    <Button AutomationId="Suggestion_Save"
                            Text="{Binding StarText}"
                            Command="{Binding SaveCommand}"
                            SemanticProperties.Description="{Binding StarDescription}"
                            Style="{StaticResource LinkButton}"
                            FontSize="22"
                            Padding="4,0"
                            VerticalOptions="Center">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSaved}" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource StarOnLight}, Dark={StaticResource StarOnDark}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Label Grid.Column="1"
                           AutomationId="Suggestion_Name"
                           Text="{Binding Name}"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource StrongLight}, Dark={StaticResource StrongDark}}"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                    <Button Grid.Column="2"
                            AutomationId="Suggestion_Explore"
                            Text="More →"
                            Command="{Binding ExploreCommand}"
                            SemanticProperties.Description="{Binding Name, StringFormat='More like {0}'}"
                            Style="{StaticResource LinkButton}"
                            VerticalOptions="Center" />
                </Grid>

                <!-- The desktop's photo: the initials on the lane's colour, until there are photos (.my/design/one-page-desktop.md). -->
                <Grid ColumnDefinitions="Auto,*" Padding="8,0,0,0" InputTransparent="True">
                    <Border x:Name="Photo"
                            IsVisible="False"
                            WidthRequest="56"
                            HeightRequest="64"
                            VerticalOptions="Start"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SafeLight}, Dark={StaticResource SafeDark}}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding LaneName}" Value="Curious">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CuriousLight}, Dark={StaticResource CuriousDark}}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding LaneName}" Value="Wild">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WildLight}, Dark={StaticResource WildDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Initials}" TextColor="White" FontAttributes="Bold" FontSize="18"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" Padding="8,0" InputTransparent="True">
                        <Label AutomationId="Suggestion_Why" Text="{Binding Why}" LineHeight="1.15" />
                        <Label AutomationId="Suggestion_Tags"
                               Text="{Binding TagsText}"
                               Style="{StaticResource Faint}" />
                        <Label AutomationId="Suggestion_KnownFor"
                               Text="{Binding KnownForText}"
                               Style="{StaticResource Faint}"
                               IsVisible="{Binding HasKnownFor}" />
                        <Label AutomationId="Suggestion_Opened"
                               Text="{Binding OpenedText}"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                               IsVisible="{Binding HasOpenedText}" />
                        <Label AutomationId="Suggestion_NotFound"
                               Text="Couldn't confirm this artist"
                               Style="{StaticResource Faint}"
                               IsVisible="{Binding IsNotFound}" />
                    </VerticalStackLayout>
                </Grid>

                <HorizontalStackLayout AutomationId="Suggestion_OtherServices"
                                       Spacing="4"
                                       IsVisible="{Binding ShowsOtherServices}"
                                       InputTransparent="True"
                                       CascadeInputTransparent="False">
                    <Label Text="Open in:" Style="{StaticResource Muted}" VerticalOptions="Center" InputTransparent="True" />
                    <Button AutomationId="Suggestion_Second"
                            Text="{Binding SecondText}"
                            Command="{Binding OpenSecondCommand}"
                            Style="{StaticResource SoftButton}" />
                    <Button AutomationId="Suggestion_Third"
                            Text="{Binding ThirdText}"
                            Command="{Binding OpenThirdCommand}"
                            Style="{StaticResource SoftButton}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
