<?xml version="1.0" encoding="utf-8" ?>
<!--
    One card, on the results and the favourites page (.my/design/results-list-changes.md). It takes its
    BindingContext from the list item. Every card repeats the same ids; item scoping keeps them apart.

    Two layers in one cell. Below, Suggestion_Card: the tap surface, which opens the Open with service,
    and on a long press (a right-click on Windows) shows the other two. Above, the content: the text lets
    taps fall through to the surface, and the star, More and the Open in links are buttons on top. They
    are siblings of the surface, not its children, so their taps never reach its gestures, on any platform.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Kofflard.Core.ViewModels;assembly=Kofflard.Core"
             x:Class="Kofflard.App.Views.SuggestionCardView"
             x:DataType="vm:SuggestionViewModel">

    <Border Padding="0" Margin="0,4" StrokeShape="RoundRectangle 10" Opacity="{Binding Opacity}">
        <Grid>
            <ContentView x:Name="TapSurface"
                         AutomationId="Suggestion_Card"
                         BackgroundColor="Transparent"
                         SemanticProperties.Description="{Binding OpenDescription}"
                         SemanticProperties.Hint="Long press for other services">
                <ContentView.Behaviors>
                    <toolkit:TouchBehavior Command="{Binding OpenCommand}"
                                           LongPressCommand="{Binding ShowOtherServicesCommand}" />
                </ContentView.Behaviors>
                <FlyoutBase.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Open in…" Command="{Binding ShowOtherServicesCommand}" />
                    </MenuFlyout>
                </FlyoutBase.ContextFlyout>
            </ContentView>

            <VerticalStackLayout Padding="12" Spacing="4" InputTransparent="True" CascadeInputTransparent="False">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4" InputTransparent="True" CascadeInputTransparent="False">
                    <Button AutomationId="Suggestion_Save"
                            Text="{Binding StarText}"
                            Command="{Binding SaveCommand}"
                            SemanticProperties.Description="{Binding StarDescription}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontSize="20"
                            Padding="4,0"
                            MinimumWidthRequest="36"
                            VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           AutomationId="Suggestion_Name"
                           Text="{Binding Name}"
                           FontSize="18"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                    <Label Grid.Column="2"
                           AutomationId="Suggestion_Verified"
                           Text="{Binding VerifiedMark}"
                           TextColor="{StaticResource Primary}"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Confirmed by MusicBrainz"
                           IsVisible="{Binding IsVerified}"
                           InputTransparent="True" />
                    <Button Grid.Column="3"
                            AutomationId="Suggestion_Explore"
                            Text="More →"
                            Command="{Binding ExploreCommand}"
                            SemanticProperties.Description="{Binding Name, StringFormat='More like {0}'}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            Padding="4,0"
                            VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Spacing="4" InputTransparent="True">
                    <Label AutomationId="Suggestion_Why" Text="{Binding Why}" />
                    <Label AutomationId="Suggestion_Tags"
                           Text="{Binding TagsText}"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}" />
                    <Label AutomationId="Suggestion_KnownFor"
                           Text="{Binding KnownForText}"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}"
                           IsVisible="{Binding HasKnownFor}" />
                    <Label AutomationId="Suggestion_Opened"
                           Text="{Binding OpenedText}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           IsVisible="{Binding HasOpenedText}" />
                    <Label AutomationId="Suggestion_NotFound"
                           Text="Couldn't confirm this artist"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}"
                           IsVisible="{Binding IsNotFound}" />
                </VerticalStackLayout>

                <HorizontalStackLayout AutomationId="Suggestion_OtherServices"
                                       Spacing="4"
                                       IsVisible="{Binding ShowsOtherServices}"
                                       InputTransparent="True"
                                       CascadeInputTransparent="False">
                    <Label Text="Open in:" VerticalOptions="Center" InputTransparent="True" />
                    <Button AutomationId="Suggestion_Second"
                            Text="{Binding SecondText}"
                            Command="{Binding OpenSecondCommand}"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="{StaticResource Tertiary}" />
                    <Button AutomationId="Suggestion_Third"
                            Text="{Binding ThirdText}"
                            Command="{Binding OpenThirdCommand}"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="{StaticResource Tertiary}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
