<?xml version="1.0" encoding="utf-8" ?>
<!--
    One card, on the results and the favourites page (.my/design/results-list-changes.md). It takes its
    BindingContext from the list item. Every card repeats the same ids; item scoping keeps them apart.

    Two layers in one cell. Below, Suggestion_Card: the tap surface, which opens the Open with service,
    and on a long press (a right-click on Windows) shows the other two. Above, the content: the text lets
    taps fall through to the surface, and the star, More and the Open in links are buttons on top. They
    are siblings of the surface, not its children, so their taps never reach its gestures, on any platform.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Kofflard.Core.ViewModels;assembly=Kofflard.Core"
             x:Class="Kofflard.App.Views.SuggestionCardView"
             x:DataType="vm:SuggestionViewModel">

    <!-- Tinted by its lane: amber Close, teal Stretch, violet Leap (.my/design/aurora.md). -->
    <Border Padding="0"
            Margin="0,6"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="1"
            Background="{AppThemeBinding Light={StaticResource CloseCardLightBrush}, Dark={StaticResource CloseCardDarkBrush}}"
            Stroke="{AppThemeBinding Light={StaticResource CloseEdgeLight}, Dark={StaticResource CloseEdgeDark}}"
            Opacity="{Binding Opacity}">
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding LaneName}" Value="Stretch">
                <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource StretchCardLightBrush}, Dark={StaticResource StretchCardDarkBrush}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource StretchEdgeLight}, Dark={StaticResource StretchEdgeDark}}" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding LaneName}" Value="Leap">
                <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource LeapCardLightBrush}, Dark={StaticResource LeapCardDarkBrush}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LeapEdgeLight}, Dark={StaticResource LeapEdgeDark}}" />
            </DataTrigger>
        </Border.Triggers>
        <Grid>
            <ContentView x:Name="TapSurface"
                         AutomationId="Suggestion_Card"
                         BackgroundColor="Transparent"
                         SemanticProperties.Description="{Binding OpenDescription}"
                         SemanticProperties.Hint="Long press for other services">
                <ContentView.Behaviors>
                    <toolkit:TouchBehavior Command="{Binding OpenCommand}"
                                           LongPressCommand="{Binding ShowOtherServicesCommand}" />
                </ContentView.Behaviors>
                <FlyoutBase.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Open in…" Command="{Binding ShowOtherServicesCommand}" />
                    </MenuFlyout>
                </FlyoutBase.ContextFlyout>
            </ContentView>

            <VerticalStackLayout Padding="8,4,8,14" Spacing="4" InputTransparent="True" CascadeInputTransparent="False">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="2" InputTransparent="True" CascadeInputTransparent="False">
                    <Button AutomationId="Suggestion_Save"
                            Text="{Binding StarText}"
                            Command="{Binding SaveCommand}"
                            SemanticProperties.Description="{Binding StarDescription}"
                            Style="{StaticResource LinkButton}"
                            FontSize="22"
                            Padding="4,0"
                            VerticalOptions="Center">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSaved}" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource StarOnLight}, Dark={StaticResource StarOnDark}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Label Grid.Column="1"
                           AutomationId="Suggestion_Name"
                           Text="{Binding Name}"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource StrongLight}, Dark={StaticResource StrongDark}}"
                           VerticalOptions="Center"
                           InputTransparent="True" />
                    <Label Grid.Column="2"
                           AutomationId="Suggestion_Verified"
                           Text="{Binding VerifiedMark}"
                           TextColor="{AppThemeBinding Light={StaticResource CloseTextLight}, Dark={StaticResource CloseTextDark}}"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Confirmed by MusicBrainz"
                           IsVisible="{Binding IsVerified}"
                           InputTransparent="True">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding LaneName}" Value="Stretch">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource StretchTextLight}, Dark={StaticResource StretchTextDark}}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding LaneName}" Value="Leap">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LeapTextLight}, Dark={StaticResource LeapTextDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.Column="3"
                            AutomationId="Suggestion_Explore"
                            Text="More →"
                            Command="{Binding ExploreCommand}"
                            SemanticProperties.Description="{Binding Name, StringFormat='More like {0}'}"
                            Style="{StaticResource LinkButton}"
                            VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Spacing="4" Padding="8,0" InputTransparent="True">
                    <Label AutomationId="Suggestion_Why" Text="{Binding Why}" LineHeight="1.15" />
                    <Label AutomationId="Suggestion_Tags"
                           Text="{Binding TagsText}"
                           Style="{StaticResource Faint}" />
                    <Label AutomationId="Suggestion_KnownFor"
                           Text="{Binding KnownForText}"
                           Style="{StaticResource Faint}"
                           IsVisible="{Binding HasKnownFor}" />
                    <Label AutomationId="Suggestion_Opened"
                           Text="{Binding OpenedText}"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                           IsVisible="{Binding HasOpenedText}" />
                    <Label AutomationId="Suggestion_NotFound"
                           Text="Couldn't confirm this artist"
                           Style="{StaticResource Faint}"
                           IsVisible="{Binding IsNotFound}" />
                </VerticalStackLayout>

                <HorizontalStackLayout AutomationId="Suggestion_OtherServices"
                                       Spacing="4"
                                       IsVisible="{Binding ShowsOtherServices}"
                                       InputTransparent="True"
                                       CascadeInputTransparent="False">
                    <Label Text="Open in:" Style="{StaticResource Muted}" VerticalOptions="Center" InputTransparent="True" />
                    <Button AutomationId="Suggestion_Second"
                            Text="{Binding SecondText}"
                            Command="{Binding OpenSecondCommand}"
                            Style="{StaticResource SoftButton}" />
                    <Button AutomationId="Suggestion_Third"
                            Text="{Binding ThirdText}"
                            Command="{Binding OpenThirdCommand}"
                            Style="{StaticResource SoftButton}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
