<?xml version="1.0" encoding="utf-8" ?>
<!-- The favourites, with the same card as the results. The route and ids stay "saved". -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kofflard.Core.ViewModels;assembly=Kofflard.Core"
             xmlns:views="clr-namespace:Kofflard.App.Views"
             x:Class="Kofflard.App.Pages.SavedPage"
             x:DataType="vm:SavedViewModel"
             AutomationId="SavedPage"
             Title="Favourites">

    <Grid RowDefinitions="Auto,*" Padding="16,8">
        <Label AutomationId="Saved_Empty"
               Text="No favourites yet. Tap ☆ in front of a name to keep it here."
               Style="{StaticResource Muted}"
               Margin="0,8"
               IsVisible="{Binding IsEmpty}" />
        <CollectionView Grid.Row="1"
                        AutomationId="Saved_Items"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedCard}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SuggestionViewModel">
                    <VerticalStackLayout AutomationId="Suggestion">
                        <views:SuggestionCardView />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
