<?xml version="1.0" encoding="utf-8" ?>
<!--
    The results (design §3.1, .my/design/results-list-changes.md). "Like Genesis" is the title bar's;
    the suggestions are grouped by lane, Safe, Curious and Wild, and the slider above them shows the lanes up
    to how adventurous the user wants to go (.my/design/adventure-as-outcomes.md). Results_State is a CommunityToolkit StateContainer, as Todo's list: its
    default content is the suggestions; Loading, Empty, Error and Candidates each carry their own
    AutomationId, which is how Bruinet's StateContainer control tells which one is showing.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Kofflard.Core.ViewModels;assembly=Kofflard.Core"
             xmlns:models="clr-namespace:Kofflard.Core.Models;assembly=Kofflard.Core"
             xmlns:views="clr-namespace:Kofflard.App.Views"
             x:Class="Kofflard.App.Pages.ResultsPage"
             x:DataType="vm:ResultsViewModel"
             AutomationId="ResultsPage"
             Title="{Binding Heading}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,8" RowSpacing="8">

        <Label AutomationId="Results_Summary" Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="15" />

        <!--
            How adventurous: three stops on a track, the chosen one glowing. It shows the lanes up to the chosen
            one; nothing is asked again (.my/design/adventure-as-outcomes.md).
        -->
        <VerticalStackLayout Grid.Row="1" Spacing="8" MaximumWidthRequest="420" IsVisible="{Binding HasContent}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="How adventurous?" Style="{StaticResource Muted}" FontSize="15" VerticalOptions="End" />
                <Label Grid.Column="1" Text="{Binding AdventureName}" Style="{StaticResource Heading}" VerticalOptions="End" />
            </Grid>
            <Grid>
                <Grid ColumnDefinitions="*,4*,*" InputTransparent="True">
                    <BoxView Grid.Column="1"
                             HeightRequest="2"
                             VerticalOptions="Start"
                             Margin="0,17,0,0"
                             Color="{AppThemeBinding Light={StaticResource TrackLight}, Dark={StaticResource TrackDark}}" />
                </Grid>
                <Grid AutomationId="Results_Adventure"
                      ColumnDefinitions="*,*,*"
                      RadioButtonGroup.GroupName="Adventure"
                      BindableLayout.ItemsSource="{Binding AdventureOptions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AdventureOptionViewModel">
                            <RadioButton AutomationId="{Binding Name, StringFormat='Adventure_{0}'}"
                                         Grid.Column="{Binding Column}"
                                         Value="{Binding Lane}"
                                         IsChecked="{Binding IsChosen}"
                                         ControlTemplate="{StaticResource AdventureChoice}"
                                         HorizontalOptions="Center"
                                         SemanticProperties.Description="{Binding Name}">
                                <RadioButton.Content>
                                    <!--
                                        The content of a templated RadioButton does not get the option as its
                                        binding context (on Windows its bindings came up empty), so it takes
                                        it from the radio button explicitly.
                                    -->
                                    <VerticalStackLayout Spacing="4"
                                                         HorizontalOptions="Center"
                                                         BindingContext="{Binding Source={RelativeSource AncestorType={x:Type vm:AdventureOptionViewModel}}}">
                                        <Grid HeightRequest="36" WidthRequest="44" HorizontalOptions="Center">
                                            <!-- The chosen stop's halo, in place of a Shadow (square on Windows). -->
                                            <Ellipse WidthRequest="34"
                                                     HeightRequest="34"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     Opacity="0.3"
                                                     IsVisible="{Binding IsChosen}"
                                                     Fill="{AppThemeBinding Light={StaticResource DotOnLight}, Dark={StaticResource WildDark}}" />
                                            <Ellipse WidthRequest="12"
                                                     HeightRequest="12"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     Fill="{AppThemeBinding Light={StaticResource DotOffLight}, Dark={StaticResource DotOffDark}}">
                                                <Ellipse.Triggers>
                                                    <DataTrigger TargetType="Ellipse" Binding="{Binding IsChosen}" Value="True">
                                                        <Setter Property="WidthRequest" Value="22" />
                                                        <Setter Property="HeightRequest" Value="22" />
                                                        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource DotOnLight}, Dark={StaticResource DotOnDark}}" />
                                                    </DataTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                        </Grid>
                                        <Label AutomationId="{Binding Name, StringFormat='Adventure_{0}_Name'}"
                                               Text="{Binding Name}"
                                               FontSize="12"
                                               HorizontalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource FaintLight}, Dark={StaticResource FaintDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsChosen}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource StrongLight}, Dark={StaticResource StrongDark}}" />
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </RadioButton.Content>
                            </RadioButton>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </Grid>
            </Grid>
        </VerticalStackLayout>

        <Grid Grid.Row="2"
              AutomationId="Results_State"
              toolkit:StateContainer.CurrentState="{Binding StateKey}">

            <toolkit:StateContainer.StateViews>
                <VerticalStackLayout toolkit:StateView.StateKey="Loading"
                                     AutomationId="Results_Loading"
                                     Spacing="8"
                                     VerticalOptions="Center">
                    <ActivityIndicator IsRunning="True" />
                    <Label Text="Asking the AI…" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout toolkit:StateView.StateKey="Empty"
                                     AutomationId="Results_Empty"
                                     VerticalOptions="Center">
                    <Label AutomationId="Results_EmptyLabel"
                           Text="The AI had no new musicians to suggest. Try again, or turn the adventure up."
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout toolkit:StateView.StateKey="Error"
                                     AutomationId="Results_Error"
                                     Spacing="12"
                                     VerticalOptions="Center">
                    <Label AutomationId="Results_ErrorLabel"
                           Text="{Binding ErrorMessage}"
                           HorizontalTextAlignment="Center" />
                    <Label AutomationId="Results_Connection"
                           Text="{Binding ConnectionLine}"
                           Style="{StaticResource Faint}"
                           HorizontalTextAlignment="Center" />
                    <Button AutomationId="Results_Retry"
                            Text="Try again"
                            Command="{Binding RetryCommand}"
                            HorizontalOptions="Center" />
                    <Button AutomationId="Results_FixConnection"
                            Text="Fix the AI connection"
                            Command="{Binding FixConnectionCommand}"
                            Style="{StaticResource SoftButton}"
                            IsVisible="{Binding CanFixConnection}"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Grid toolkit:StateView.StateKey="Candidates"
                      AutomationId="Results_Candidates"
                      RowDefinitions="Auto,*"
                      RowSpacing="8">
                    <Label AutomationId="Results_CandidatesTitle" Text="{Binding CandidatesTitle}" Style="{StaticResource Heading}" />
                    <CollectionView Grid.Row="1"
                                    AutomationId="Results_CandidateList"
                                    ItemsSource="{Binding Candidates}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedCandidate}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Musician">
                                <VerticalStackLayout AutomationId="CandidateRow" Padding="8">
                                    <Label AutomationId="CandidateRow_Name" Text="{Binding Name}" Style="{StaticResource Heading}" FontSize="16" />
                                    <Label AutomationId="CandidateRow_Summary" Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </toolkit:StateContainer.StateViews>

            <CollectionView AutomationId="Results_Items"
                            ItemsSource="{Binding Lanes}"
                            IsGrouped="True"
                            SelectionMode="None">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:LaneGroupViewModel">
                        <!-- The lane's name in its colour: amber Safe, teal Curious, violet Wild. -->
                        <Grid AutomationId="LaneHeader" Padding="4,14,0,2">
                            <Label AutomationId="LaneHeader_Name"
                                   Text="{Binding HeaderText}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   CharacterSpacing="1"
                                   TextColor="{AppThemeBinding Light={StaticResource SafeTextLight}, Dark={StaticResource SafeTextDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Name}" Value="Curious">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CuriousTextLight}, Dark={StaticResource CuriousTextDark}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Name}" Value="Wild">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WildTextLight}, Dark={StaticResource WildTextDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SuggestionViewModel">
                        <VerticalStackLayout AutomationId="Suggestion">
                            <views:SuggestionCardView />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Button Grid.Row="3"
                AutomationId="Results_More"
                Text="More like this…"
                HeightRequest="52"
                CornerRadius="26"
                Command="{Binding MoreCommand}"
                IsVisible="{Binding HasContent}" />
    </Grid>
</ContentPage>
