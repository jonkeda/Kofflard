<?xml version="1.0" encoding="utf-8" ?>
<!--
    The results on the desktop design (design §3.1, .my/design/results-list-changes.md). "Like Genesis" is
    the title bar's; the list and its states are ResultsView, shared with the phone's one page.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kofflard.Core.ViewModels;assembly=Kofflard.Core"
             xmlns:views="clr-namespace:Kofflard.App.Views"
             x:Class="Kofflard.App.Pages.ResultsPage"
             x:DataType="vm:ResultsViewModel"
             AutomationId="ResultsPage"
             Title="{Binding Heading}">

    <views:ResultsView />
</ContentPage>
