<?xml version="1.0" encoding="utf-8" ?>
<!--
    The search page, the Shell root (design §3.1), in the Aurora look (.my/design/aurora.md). Ids are the
    contract with the page objects: renaming one breaks them.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kofflard.Core.ViewModels;assembly=Kofflard.Core"
             xmlns:services="clr-namespace:Kofflard.Core.Services;assembly=Kofflard.Core"
             x:Class="Kofflard.App.Pages.SearchPage"
             x:DataType="vm:SearchViewModel"
             AutomationId="SearchPage"
             Title="Kofflard">

    <!-- Icons on the title bar, dark on the light sky; the text is each item's accessible name (.my/design/search-page-changes.md). -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Favourites" IconImageSource="{AppThemeBinding Light=star_dark.png, Dark=star.png}" AutomationId="Search_Saved" Command="{Binding SavedCommand}" />
        <ToolbarItem Text="Settings" IconImageSource="{AppThemeBinding Light=settings_dark.png, Dark=settings.png}" AutomationId="Search_Settings" Command="{Binding SettingsCommand}" />
    </ContentPage.ToolbarItems>

    <!-- One column, kept to phone width on a wide window. -->
    <Grid RowDefinitions="Auto,*"
          Padding="16,8,16,16"
          RowSpacing="8"
          MaximumWidthRequest="560"
          HorizontalOptions="Center">

        <VerticalStackLayout Spacing="20">

            <!--
                The orb: glowing rings around the question and the name. The glow is two wide, faint strokes
                under the ring: a Shadow on a shape is drawn as a square on Windows.
            -->
            <Grid WidthRequest="300" HeightRequest="300" HorizontalOptions="Center">
                <Ellipse WidthRequest="296" HeightRequest="296"
                         StrokeThickness="12"
                         Opacity="0.12"
                         Stroke="{AppThemeBinding Light={StaticResource RingLightBrush}, Dark={StaticResource RingDarkBrush}}"
                         InputTransparent="True" />
                <Ellipse WidthRequest="292" HeightRequest="292"
                         StrokeThickness="6"
                         Opacity="0.25"
                         Stroke="{AppThemeBinding Light={StaticResource RingLightBrush}, Dark={StaticResource RingDarkBrush}}"
                         InputTransparent="True" />
                <Ellipse WidthRequest="288" HeightRequest="288"
                         StrokeThickness="2.5"
                         Stroke="{AppThemeBinding Light={StaticResource RingLightBrush}, Dark={StaticResource RingDarkBrush}}"
                         InputTransparent="True" />
                <Ellipse WidthRequest="270" HeightRequest="270"
                         StrokeThickness="1"
                         StrokeDashArray="1,5"
                         Opacity="0.7"
                         Stroke="{AppThemeBinding Light={StaticResource Ring2Light}, Dark={StaticResource Ring2Dark}}"
                         InputTransparent="True" />
                <Ellipse WidthRequest="244" HeightRequest="244"
                         StrokeThickness="1"
                         Fill="{AppThemeBinding Light={StaticResource OrbLight}, Dark={StaticResource OrbDark}}"
                         Stroke="{AppThemeBinding Light={StaticResource ChipEdgeLight}, Dark={StaticResource ChipEdgeDark}}"
                         InputTransparent="True" />

                <VerticalStackLayout WidthRequest="210" Spacing="14" VerticalOptions="Center">
                    <Label Text="Who do you like?"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource AskLight}, Dark={StaticResource AskDark}}" />
                    <Border Style="{StaticResource Field}">
                        <Entry AutomationId="Search_Name"
                               Placeholder="A musician or band"
                               Text="{Binding Name}"
                               FontSize="18"
                               FontAttributes="Bold"
                               ReturnCommand="{Binding SearchCommand}"
                               SemanticProperties.Hint="Type the name of a musician you like" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Label AutomationId="Search_NameError"
                   Style="{StaticResource Error}"
                   Text="{Binding NameError}"
                   HorizontalOptions="Center"
                   IsVisible="{Binding HasNameError}" />

            <Button AutomationId="Search_Go"
                    Text="Find musicians"
                    FontSize="18"
                    HeightRequest="56"
                    CornerRadius="28"
                    Command="{Binding SearchCommand}">
                <Button.Shadow>
                    <Shadow Brush="{AppThemeBinding Light={StaticResource Ring2Light}, Dark={StaticResource Ring2Dark}}"
                            Radius="20"
                            Opacity="0.45"
                            Offset="0,6" />
                </Button.Shadow>
            </Button>

            <Label Text="RECENT" Style="{StaticResource Faint}" CharacterSpacing="1.5" IsVisible="{Binding HasRecent}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        AutomationId="Search_Recent"
                        ItemsSource="{Binding Recent}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedRecent}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:RecentSearch">
                    <Grid AutomationId="RecentRow" Padding="0,4">
                        <Border Padding="16,10"
                                HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource ChipEdgeLight}, Dark={StaticResource ChipEdgeDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource ChipLight}, Dark={StaticResource ChipDark}}">
                            <Label AutomationId="RecentRow_Artist" Text="{Binding Artist}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
