<?xml version="1.0" encoding="utf-8" ?>
<!--
    The search page, the Shell root (design §3.1), in the Aurora look (.my/design/aurora.md). Ids are the
    contract with the page objects: renaming one breaks them.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kofflard.Core.ViewModels;assembly=Kofflard.Core"
             xmlns:services="clr-namespace:Kofflard.Core.Services;assembly=Kofflard.Core"
             xmlns:models="clr-namespace:Kofflard.Core.Models;assembly=Kofflard.Core"
             x:Class="Kofflard.App.Pages.SearchPage"
             x:DataType="vm:SearchViewModel"
             AutomationId="SearchPage"
             Title="Kofflard">

    <!-- Icons on the title bar, dark on the light sky; the text is each item's accessible name (.my/design/search-page-changes.md). -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Favourites" IconImageSource="{AppThemeBinding Light=star_dark.png, Dark=star.png}" AutomationId="Search_Saved" Command="{Binding SavedCommand}" />
        <ToolbarItem Text="Settings" IconImageSource="{AppThemeBinding Light=settings_dark.png, Dark=settings.png}" AutomationId="Search_Settings" Command="{Binding SettingsCommand}" />
    </ContentPage.ToolbarItems>

    <!-- One column, kept to phone width on a wide window. -->
    <Grid RowDefinitions="Auto,*"
          Padding="16,8,16,16"
          RowSpacing="8"
          MaximumWidthRequest="560"
          HorizontalOptions="Center">

        <VerticalStackLayout Spacing="20">

            <!--
                The orb: glowing rings around the question and the name. The glow is two wide, faint strokes
                under the ring: a Shadow on a shape is drawn as a square on Windows.
            -->
            <Grid WidthRequest="300" HeightRequest="300" HorizontalOptions="Center">
                <Ellipse WidthRequest="296" HeightRequest="296"
                         StrokeThickness="12"
                         Opacity="0.12"
                         Stroke="{AppThemeBinding Light={StaticResource RingLightBrush}, Dark={StaticResource RingDarkBrush}}"
                         InputTransparent="True" />
                <Ellipse WidthRequest="292" HeightRequest="292"
                         StrokeThickness="6"
                         Opacity="0.25"
                         Stroke="{AppThemeBinding Light={StaticResource RingLightBrush}, Dark={StaticResource RingDarkBrush}}"
                         InputTransparent="True" />
                <Ellipse WidthRequest="288" HeightRequest="288"
                         StrokeThickness="2.5"
                         Stroke="{AppThemeBinding Light={StaticResource RingLightBrush}, Dark={StaticResource RingDarkBrush}}"
                         InputTransparent="True" />
                <Ellipse WidthRequest="270" HeightRequest="270"
                         StrokeThickness="1"
                         StrokeDashArray="1,5"
                         Opacity="0.7"
                         Stroke="{AppThemeBinding Light={StaticResource Ring2Light}, Dark={StaticResource Ring2Dark}}"
                         InputTransparent="True" />
                <Ellipse WidthRequest="244" HeightRequest="244"
                         StrokeThickness="1"
                         Fill="{AppThemeBinding Light={StaticResource OrbLight}, Dark={StaticResource OrbDark}}"
                         Stroke="{AppThemeBinding Light={StaticResource ChipEdgeLight}, Dark={StaticResource ChipEdgeDark}}"
                         InputTransparent="True" />

                <VerticalStackLayout WidthRequest="210" Spacing="14" VerticalOptions="Center">
                    <Label Text="Who do you like?"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource AskLight}, Dark={StaticResource AskDark}}" />
                    <Border Style="{StaticResource Field}">
                        <Entry AutomationId="Search_Name"
                               Placeholder="A musician or band"
                               Text="{Binding Name}"
                               FontSize="18"
                               FontAttributes="Bold"
                               ReturnCommand="{Binding SearchCommand}"
                               SemanticProperties.Hint="Type the name of a musician you like" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Label AutomationId="Search_NameError"
                   Style="{StaticResource Error}"
                   Text="{Binding NameError}"
                   HorizontalOptions="Center"
                   IsVisible="{Binding HasNameError}" />

            <!-- A search waits here for its first card; "Searching…" until then (.my/design/desktop-aurora-changes.md). -->
            <Grid>
                <Button AutomationId="Search_Go"
                        Text="{Binding GoButtonText}"
                        IsEnabled="{Binding CanSearch}"
                        FontSize="18"
                        HeightRequest="56"
                        CornerRadius="28"
                        Command="{Binding SearchCommand}">
                    <Button.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource Ring2Light}, Dark={StaticResource Ring2Dark}}"
                                Radius="20"
                                Opacity="0.45"
                                Offset="0,6" />
                    </Button.Shadow>
                </Button>
                <ActivityIndicator AutomationId="Search_Busy"
                                   IsRunning="{Binding IsWaiting}"
                                   IsVisible="{Binding IsWaiting}"
                                   HeightRequest="22"
                                   WidthRequest="22"
                                   Margin="0,0,24,0"
                                   Color="White"
                                   HorizontalOptions="End"
                                   InputTransparent="True" />
            </Grid>

            <!-- What came of a search that opened no page: nobody found, or an error. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasMessage}">
                <Label AutomationId="Search_Message"
                       Text="{Binding Message}"
                       HorizontalTextAlignment="Center" />
                <Button AutomationId="Search_FixConnection"
                        Text="Fix connection"
                        Style="{StaticResource SoftButton}"
                        HorizontalOptions="Center"
                        Command="{Binding FixConnectionCommand}"
                        IsVisible="{Binding CanFixConnection}" />
            </VerticalStackLayout>

            <!-- "Did you mean…": a question about the name, so it is asked here. -->
            <VerticalStackLayout AutomationId="Search_Candidates" Spacing="4" IsVisible="{Binding HasCandidates}">
                <Label AutomationId="Search_CandidatesTitle" Text="{Binding CandidatesTitle}" Style="{StaticResource Heading}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Candidates}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Musician">
                            <Button AutomationId="{Binding Name, StringFormat='Candidate_{0}'}"
                                    Text="{Binding Name}"
                                    Style="{StaticResource LinkButton}"
                                    HorizontalOptions="Start"
                                    Command="{Binding ChooseCandidateCommand, Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}}"
                                    CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Label Text="RECENT" Style="{StaticResource Faint}" CharacterSpacing="1.5" IsVisible="{Binding HasRecent}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        AutomationId="Search_Recent"
                        ItemsSource="{Binding Recent}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedRecent}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:RecentSearch">
                    <Grid AutomationId="RecentRow" Padding="0,4">
                        <Border Padding="16,0,4,0"
                                HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource ChipEdgeLight}, Dark={StaticResource ChipEdgeDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource ChipLight}, Dark={StaticResource ChipDark}}">
                            <HorizontalStackLayout Spacing="2">
                                <Label AutomationId="RecentRow_Artist" Text="{Binding Artist}" VerticalOptions="Center" />
                                <!-- ✕ forgets the search; its own button, so it doesn't select the chip (.my/design/desktop-aurora-changes.md). -->
                                <Button AutomationId="{Binding Artist, StringFormat='RecentRow_Remove_{0}'}"
                                        Text="✕"
                                        Style="{StaticResource LinkButton}"
                                        FontSize="14"
                                        Padding="10,0"
                                        MinimumHeightRequest="40"
                                        SemanticProperties.Description="{Binding Artist, StringFormat='Remove {0} from recent'}"
                                        Command="{Binding RemoveRecentCommand, Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
