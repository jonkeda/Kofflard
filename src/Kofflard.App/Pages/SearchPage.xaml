<?xml version="1.0" encoding="utf-8" ?>
<!--
    The search page, the Shell root (design §3.1). Ids are the contract with the page objects: renaming
    one breaks them.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kofflard.Core.ViewModels;assembly=Kofflard.Core"
             xmlns:services="clr-namespace:Kofflard.Core.Services;assembly=Kofflard.Core"
             x:Class="Kofflard.App.Pages.SearchPage"
             x:DataType="vm:SearchViewModel"
             AutomationId="SearchPage"
             Title="Kofflard">

    <!-- Icons on the Primary title bar; the text is each item's accessible name (.my/design/search-page-changes.md). -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Favourites" IconImageSource="star.png" AutomationId="Search_Saved" Command="{Binding SavedCommand}" />
        <ToolbarItem Text="Settings" IconImageSource="settings.png" AutomationId="Search_Settings" Command="{Binding SettingsCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <VerticalStackLayout Spacing="10">
            <Label Text="Who do you like?" FontSize="24" FontAttributes="Bold" />

            <Entry AutomationId="Search_Name"
                   Placeholder="A musician or band"
                   Text="{Binding Name}"
                   ReturnCommand="{Binding SearchCommand}"
                   SemanticProperties.Hint="Type the name of a musician you like" />
            <Label AutomationId="Search_NameError"
                   Text="{Binding NameError}"
                   TextColor="Red"
                   IsVisible="{Binding HasNameError}" />

            <Label Text="How adventurous?" />
            <Grid AutomationId="Search_Adventure"
                  ColumnDefinitions="*,*,*,*,*"
                  ColumnSpacing="6"
                  RadioButtonGroup.GroupName="Adventure"
                  BindableLayout.ItemsSource="{Binding AdventureOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:AdventureOptionViewModel">
                        <RadioButton AutomationId="{Binding Name, StringFormat='Adventure_{0}'}"
                                     Grid.Column="{Binding Column}"
                                     Value="{Binding Adventure.Level}"
                                     IsChecked="{Binding IsChosen}"
                                     ControlTemplate="{StaticResource AdventureChoice}"
                                     SemanticProperties.Description="{Binding Name}">
                            <RadioButton.Content>
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Image Source="{Binding Icon}" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" />
                                    <Label Text="{Binding Name}" FontSize="11" HorizontalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsChosen}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsChosen}" Value="False">
                                                <Setter Property="TextColor" Value="{StaticResource Tertiary}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </RadioButton.Content>
                        </RadioButton>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </Grid>

            <Button AutomationId="Search_Go"
                    Text="Find musicians"
                    Command="{Binding SearchCommand}" />

            <Label Text="Recent" FontAttributes="Bold" IsVisible="{Binding HasRecent}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        AutomationId="Search_Recent"
                        ItemsSource="{Binding Recent}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedRecent}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:RecentSearch">
                    <Grid AutomationId="RecentRow" Padding="8">
                        <Label AutomationId="RecentRow_Artist" Text="{Binding Artist}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
