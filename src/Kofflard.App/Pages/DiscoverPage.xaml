<?xml version="1.0" encoding="utf-8" ?>
<!--
    The phone's one page (.my/design/single-page-phone.md): the list fills the screen and the search sits in
    the dock at the bottom, in thumb reach and over the keyboard. A card's search replaces the list; the
    trail goes back. The desktop and tablet design is SearchPage and ResultsPage instead.
    The parts keep the ids they have on the desktop design (Search_*, Results_*), so the page objects work on
    both; Discover_* and Lane_* are this page's own.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Kofflard.Core.ViewModels;assembly=Kofflard.Core"
             xmlns:services="clr-namespace:Kofflard.Core.Services;assembly=Kofflard.Core"
             xmlns:views="clr-namespace:Kofflard.App.Views"
             x:Class="Kofflard.App.Pages.DiscoverPage"
             x:DataType="vm:DiscoverViewModel"
             AutomationId="DiscoverPage"
             Title="Kofflard">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Favourites" IconImageSource="{AppThemeBinding Light=star_dark.png, Dark=star.png}" AutomationId="Search_Saved" Command="{Binding Search.SavedCommand}" />
        <ToolbarItem Text="Settings" IconImageSource="{AppThemeBinding Light=settings_dark.png, Dark=settings.png}" AutomationId="Search_Settings" Command="{Binding Search.SettingsCommand}" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <!-- A lane toggle off: glass with an edge and text in the lane's colour. On: filled (the triggers). -->
        <Style x:Key="LaneToggle" TargetType="Button">
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource ChipLight}, Dark={StaticResource ChipDark}}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- The trail: the search this one came from. -->
        <Button AutomationId="Discover_Back"
                Margin="16,4,16,0"
                HorizontalOptions="Start"
                Text="{Binding TrailText, StringFormat='‹ {0}'}"
                Style="{StaticResource SoftButton}"
                Command="{Binding BackCommand}"
                IsVisible="{Binding HasTrail}"
                SemanticProperties.Description="{Binding TrailText, StringFormat='Back to {0}'}" />

        <!-- "Like Vashti Bunyan · 8 of 12". -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="16,4,16,0"
                             Spacing="2"
                             IsVisible="{Binding HasResults}">
            <Label AutomationId="Discover_Heading"
                   Text="{Binding Results.Heading}"
                   Style="{StaticResource Heading}"
                   FontSize="26" />
            <Label AutomationId="Discover_Count"
                   Text="{Binding Results.CountText}"
                   Style="{StaticResource Muted}" />
        </VerticalStackLayout>

        <!-- The results; Recent covers them while the name field is focused and empty. -->
        <views:ResultsView Grid.Row="2"
                           BindingContext="{Binding Results}"
                           IsVisible="{Binding HasResults}" />

        <Grid Grid.Row="2"
              AutomationId="Discover_Recent"
              RowDefinitions="*,Auto,Auto"
              Padding="16,0"
              RowSpacing="8"
              IsVisible="{Binding ShowsRecent}"
              Background="{AppThemeBinding Light={StaticResource SkyLight}, Dark={StaticResource SkyDark}}">
            <VerticalStackLayout Spacing="8" VerticalOptions="End" Padding="0,0,0,16">
                <Label Text="Who do you like?"
                       FontSize="28"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource AskLight}, Dark={StaticResource AskDark}}" />
                <Label Text="Name a musician or band below, and find who to listen to next."
                       Style="{StaticResource Muted}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Label Grid.Row="1" Text="RECENT" Style="{StaticResource Faint}" CharacterSpacing="1.5" IsVisible="{Binding Search.HasRecent}" />
            <FlexLayout Grid.Row="2"
                        AutomationId="Search_Recent"
                        Wrap="Wrap"
                        Margin="0,0,0,12"
                        BindableLayout.ItemsSource="{Binding Search.Recent}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="services:RecentSearch">
                        <Border AutomationId="RecentRow"
                                Margin="0,0,8,8"
                                Padding="4,0"
                                StrokeShape="RoundRectangle 22"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource ChipEdgeLight}, Dark={StaticResource ChipEdgeDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource ChipLight}, Dark={StaticResource ChipDark}}">
                            <HorizontalStackLayout>
                                <Button AutomationId="{Binding Artist, StringFormat='Recent_{0}'}"
                                        Text="{Binding Artist}"
                                        Style="{StaticResource LinkButton}"
                                        Padding="12,0,2,0"
                                        Command="{Binding Search.OpenRecentCommand, Source={RelativeSource AncestorType={x:Type vm:DiscoverViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                <Button AutomationId="{Binding Artist, StringFormat='RecentRow_Remove_{0}'}"
                                        Text="✕"
                                        Style="{StaticResource LinkButton}"
                                        FontSize="14"
                                        Padding="10,0"
                                        SemanticProperties.Description="{Binding Artist, StringFormat='Remove {0} from recent'}"
                                        Command="{Binding Search.RemoveRecentCommand, Source={RelativeSource AncestorType={x:Type vm:DiscoverViewModel}}}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </Grid>

        <!-- The dock: the lane toggles, then the name in the orb's glow, and ➤. -->
        <Border Grid.Row="3"
                AutomationId="Discover_Dock"
                Padding="16,12,16,20"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24,24,0,0"
                Stroke="{AppThemeBinding Light={StaticResource ChipEdgeLight}, Dark={StaticResource ChipEdgeDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource InputLight}, Dark={StaticResource InputDark}}">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        AutomationId="Lane_Safe"
                        BindingContext="{Binding Toggles[0]}"
                        x:DataType="vm:LaneToggleViewModel"
                        Text="{Binding Name}"
                        Command="{Binding ToggleCommand}"
                        SemanticProperties.Description="{Binding Description}"
                        Style="{StaticResource LaneToggle}"
                        BorderColor="{AppThemeBinding Light={StaticResource SafeEdgeLight}, Dark={StaticResource SafeEdgeDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource SafeTextLight}, Dark={StaticResource SafeTextDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsOn}" Value="True">
                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource SafeLight}, Dark={StaticResource SafeDark}}" />
                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource SafeLight}, Dark={StaticResource SafeDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1A1003, Dark=#1A1003}" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1"
                        AutomationId="Lane_Curious"
                        BindingContext="{Binding Toggles[1]}"
                        x:DataType="vm:LaneToggleViewModel"
                        Text="{Binding Name}"
                        Command="{Binding ToggleCommand}"
                        SemanticProperties.Description="{Binding Description}"
                        Style="{StaticResource LaneToggle}"
                        BorderColor="{AppThemeBinding Light={StaticResource CuriousEdgeLight}, Dark={StaticResource CuriousEdgeDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource CuriousTextLight}, Dark={StaticResource CuriousTextDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsOn}" Value="True">
                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource CuriousLight}, Dark={StaticResource CuriousDark}}" />
                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource CuriousLight}, Dark={StaticResource CuriousDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#04201C}" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2"
                        AutomationId="Lane_Wild"
                        BindingContext="{Binding Toggles[2]}"
                        x:DataType="vm:LaneToggleViewModel"
                        Text="{Binding Name}"
                        Command="{Binding ToggleCommand}"
                        SemanticProperties.Description="{Binding Description}"
                        Style="{StaticResource LaneToggle}"
                        BorderColor="{AppThemeBinding Light={StaticResource WildEdgeLight}, Dark={StaticResource WildEdgeDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource WildTextLight}, Dark={StaticResource WildTextDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsOn}" Value="True">
                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource WildLight}, Dark={StaticResource WildDark}}" />
                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource WildLight}, Dark={StaticResource WildDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1B0B3A}" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                </Grid>

                <Label AutomationId="Search_NameError"
                       Style="{StaticResource Error}"
                       Text="{Binding Search.NameError}"
                       IsVisible="{Binding Search.HasNameError}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Border Padding="2"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 26"
                            Background="{AppThemeBinding Light={StaticResource RingLightBrush}, Dark={StaticResource RingDarkBrush}}">
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 24"
                                Padding="14,0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputLight}, Dark={StaticResource InputDark}}">
                            <Entry x:Name="NameEntry"
                                   AutomationId="Search_Name"
                                   Placeholder="Who do you like?"
                                   Text="{Binding Search.Name}"
                                   FontSize="17"
                                   HeightRequest="48"
                                   ReturnType="Search"
                                   ReturnCommand="{Binding Search.SearchCommand}"
                                   Focused="OnNameFocused"
                                   Unfocused="OnNameUnfocused"
                                   SemanticProperties.Hint="Type the name of a musician you like" />
                        </Border>
                    </Border>
                    <Button Grid.Column="1"
                            AutomationId="Search_Go"
                            Text="➤"
                            FontSize="20"
                            WidthRequest="52"
                            HeightRequest="52"
                            CornerRadius="26"
                            Padding="0"
                            Command="{Binding Search.SearchCommand}"
                            SemanticProperties.Description="Find musicians" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
