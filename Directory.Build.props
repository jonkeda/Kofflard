<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>

    <!-- Where Bruinet lives: the external/test-tooling submodule. -->
    <BruinetRoot>$(MSBuildThisFileDirectory)external/test-tooling/</BruinetRoot>

    <!-- Whether the MAUI suites build with the Windows head (FlaUI, net10.0-windows): on Windows, yes.
         Elsewhere they build for plain net10.0, with the MauiHeadless and Appium heads only (as Bruinet does). -->
    <BruinetWindowsHead Condition="'$(BruinetWindowsHead)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</BruinetWindowsHead>
  </PropertyGroup>
</Project>
