      "clips": [
        {
          "text": "Kofflard starts with one question: who do you like?",
          "start": 0,
          "end": 3.5
        },
        {
          "text": "Say, De Dijk.",
          "start": 4.7394026,
          "end": 6.7914026
        },
        {
          "text": "Eleven musicians, side by side: safe, curious and wild, and a map of how they connect.",
          "start": 6.8000241,
          "end": 13.5660241
        },
        {
          "text": "Safe: Doe Maar, from the same Dutch stages.",
          "start": 13.5708222,
          "end": 16.8068222
        },
        {
          "text": "Curious: Boudewijn de Groot, older and quieter.",
          "start": 16.8167253,
          "end": 21.052725300000002
        },
        {
          "text": "And wild: Solomon Burke, American soul.",
          "start": 21.0624554,
          "end": 24.394455400000002
        },
        {
          "text": "Every wild one says why: he made a whole album with De Dijk.",
          "start": 24.4005112,
          "end": 28.8925112
        }
      ],
