      "clips": [
        {
          "text": "Kofflard starts with one question: who do you like?",
          "start": 0,
          "end": 3.5
        },
        {
          "text": "Type De Dijk, at the bottom, right under your thumb.",
          "start": 4.7335573,
          "end": 7.8735573
        },
        {
          "text": "Eleven musicians, from safe to wild.",
          "start": 7.878765,
          "end": 10.994765
        },
        {
          "text": "Safe: Doe Maar, from the same Dutch stages.",
          "start": 10.9988434,
          "end": 14.2348434
        },
        {
          "text": "Curious: Boudewijn de Groot, older and quieter.",
          "start": 14.2344702,
          "end": 18.4704702
        },
        {
          "text": "And wild: Solomon Burke, American soul.",
          "start": 18.4809486,
          "end": 21.812948600000002
        },
        {
          "text": "Every wild one says why: he made a whole album with De Dijk.",
          "start": 21.8242573,
          "end": 26.3162573
        }
      ],
